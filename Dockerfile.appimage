FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
ENV LANG=C.UTF-8
ENV LC_ALL=C.UTF-8
ENV APPIMAGE_EXTRACT_AND_RUN=1

RUN apt-get update && apt-get install -y \
    python3 python3-pip python3-venv \
    patchelf wget file fuse \
    libegl1 libgl1 libglx0 libgles2 libopengl0 \
    libx11-6 libxext6 libxrender1 libxi6 libxtst6 \
    libxkbcommon0 libxkbcommon-x11-0 \
    libxcb1 libxcb-cursor0 libxcb-xinerama0 libxcb-icccm4 \
    libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
    libxcb-render-util0 libxcb-shape0 libxcb-xfixes0 \
    libxcb-sync1 libxcb-shm0 libxcb-glx0 libxcb-util1 \
    libfontconfig1 libfreetype6 libdbus-1-3 \
    libgtk-3-0 libpango-1.0-0 libpangocairo-1.0-0 \
    libcairo2 libcairo-gobject2 libgdk-pixbuf-2.0-0 \
    libharfbuzz0b libatk1.0-0 libatk-bridge2.0-0 \
    libglib2.0-0 ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN wget -q https://github.com/linuxdeploy/linuxdeploy/releases/download/continuous/linuxdeploy-x86_64.AppImage \
         -O /usr/local/bin/linuxdeploy \
    && wget -q https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage \
         -O /usr/local/bin/appimagetool \
    && chmod +x /usr/local/bin/linuxdeploy /usr/local/bin/appimagetool

WORKDIR /src
COPY requirements.txt .
RUN pip3 install --upgrade pip && pip3 install -r requirements.txt

CMD ["bash"]